PORT=5000
# Comma-separated list of frontend origins allowed to call this server
ALLOWED_ORIGINS=http://localhost:5173

# Code execution (free keys from jdoodle.com -> Compiler API). Keep these private.
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=

# AI assistant: a free key from https://aistudio.google.com/apikey . Keep it private.
GEMINI_API_KEY=
# Optional: which Gemini model answers (the default is free and fast)
# ASSISTANT_MODEL=gemini-3.5-flash-lite